# Copy to .env.local for local development. On Vercel, add these in
# Project Settings → Environment Variables (Production and Preview).

# Long random string used to sign login sessions. Generate with: openssl rand -base64 48
AUTH_SECRET=

# Administrator account (role: admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional regular user accounts (role: user), as a JSON array
USERS=[]

# Optional Postgres database (e.g. Neon or Vercel Postgres) for self-registered users.
# When set, people can request an account at /register, and the admin approves them
# on the /admin dashboard. The table is created automatically.
DATABASE_URL=
